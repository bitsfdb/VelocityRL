{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VelocityRL",
  "version": "2.0.0",
  "identifier": "com.velocityrl.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "echo build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VelocityRL",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "create": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "hooks.nsh"
      },
      "wix": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/items.json": "items.json",
      "../resources/titles.json": "titles.json",
      "resources/certs/velocityrl_ca.crt": "psynet_proxy/velocityrl_ca.crt",
      "resources/certs/velocityrl.crl": "psynet_proxy/velocityrl.crl",
      "resources/certs/leaf_config.psynet.gg.crt": "psynet_proxy/leaf_config.psynet.gg.crt",
      "resources/certs/leaf_config.psynet.gg.key": "psynet_proxy/leaf_config.psynet.gg.key",
      "resources/certs/leaf_ws.rlpp.psynet.gg.crt": "psynet_proxy/leaf_ws.rlpp.psynet.gg.crt",
      "resources/certs/leaf_ws.rlpp.psynet.gg.key": "psynet_proxy/leaf_ws.rlpp.psynet.gg.key"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://(discord\\.gg|github\\.com|velocityrl\\.tech)"
    },
    "updater": {
      "endpoints": [
        "https://api.velocityrl.tech/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQTUyMzU4MUMwMTI1RDEKUldUUkpRRWNXQ09sb1A2K3BDRkhIVkRVMDMyUGVTQUdoQ2c0WUlMcDNUNXFNMW5tOGFHWTRPTHgK"
    }
  }
}